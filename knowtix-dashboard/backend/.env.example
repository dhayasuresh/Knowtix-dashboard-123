import express from "express";
import mysql from "mysql2";
import cors from "cors";
import bodyParser from "body-parser";
import bcrypt from "bcrypt";

const app = express();
app.use(cors());
app.use(bodyParser.json());

// MySQL connection
const db = mysql.createConnection({
  host: "localhost",
  user: "root",
  password: "1234",
  database: "knowtix",
});

db.connect((err) => {
  if (err) return console.error("MySQL connection failed:", err);
  console.log("✅ Connected to MySQL");
});

// -------------------- Register User --------------------
app.post("/api/register", async (req, res) => {
  const { name, email, grade, password } = req.body;
  if (!name || !email || !grade || !password)
    return res.status(400).json({ error: "Missing fields" });

  try {
    const hashedPassword = await bcrypt.hash(password, 10);
    db.query(
      "INSERT INTO users (name, email, grade, password) VALUES (?, ?, ?, ?)",
      [name, email, grade, hashedPassword],
      (err, result) => {
        if (err) return res.status(500).json({ error: "DB error" });

        console.log("🆕 New user registered:");
        console.table([{ name, email, grade, password: "****" }]);
        res.json({ success: true, userId: result.insertId });
      }
    );
  } catch (err) {
    res.status(500).json({ error: "Server error" });
  }
});

// -------------------- Login User --------------------
app.post("/api/login", (req, res) => {
  const { email, password } = req.body;

  db.query("SELECT * FROM users WHERE email = ?", [email], async (err, results) => {
    if (err) return res.status(500).json({ error: "DB error" });
    if (results.length === 0) return res.status(401).json({ success: false, message: "Invalid credentials" });

    const user = results[0];
    const match = await bcrypt.compare(password, user.password);
    if (!match) return res.status(401).json({ success: false, message: "Invalid credentials" });

    console.log("✅ User logged in:");
    console.table([{ name: user.name, email: user.email, grade: user.grade, password: "****" }]);
    res.json({ success: true, userId: user.id });
  });
});

// -------------------- Get Users as JSON --------------------
app.get("/api/users", (req, res) => {
  db.query("SELECT * FROM users ORDER BY id ASC", (err, results) => {
    if (err) return res.status(500).json({ error: "DB error" });

    const maskedUsers = results.map((u, index) => ({
      id: index + 1,           // sequential ID
      name: u.name,
      username: u.username,
      email: u.email,
      password: '****',        // mask
      score: u.score,
      interest_rating: u.interest_rating,
      grade: u.grade
    }));

    res.json(maskedUsers);
  });
});

// -------------------- Get Users as HTML Table --------------------
app.get("/users-table", (req, res) => {
  db.query("SELECT * FROM users ORDER BY id ASC", (err, results) => {
    if (err) return res.status(500).send("DB error");

    let tableRows = results.map((u, index) => `
      <tr>
        <td>${index+1}</td>
        <td>${u.name || ""}</td>
        <td>${u.username || ""}</td>
        <td>${u.email}</td>
        <td>****</td>
        <td>${u.score}</td>
        <td>${u.interest_rating}</td>
        <td>${u.grade || ""}</td>
      </tr>
    `).join("");

    const html = `
      <html>
      <head>
        <title>Users Table</title>
        <style>
          table { border-collapse: collapse; width: 100%; }
          th, td { border: 1px solid #000; padding: 8px; text-align: left; }
          th { background-color: #f2f2f2; }
        </style>
      </head>
      <body>
        <h2>Users</h2>
        <table>
          <thead>
            <tr>
              <th>ID</th><th>Name</th><th>Username</th><th>Email</th><th>Password</th>
              <th>Score</th><th>Interest Rating</th><th>Grade</th>
            </tr>
          </thead>
          <tbody>${tableRows}</tbody>
        </table>
      </body>
      </html>
    `;
    res.send(html);
  });
});

app.listen(5000, () => console.log("🚀 Server running on port 5000"));
