  flex-direction: column;
  gap: 0.75rem;
}

.task-edit-input {
  padding: 0.5rem 0.75rem;
  border-radius: var(--border-radius);
  border: 1px solid #e2e8f0;
  background-color: var(--light-card);
  color: var(--light-text);
  font-size: 0.875rem;
