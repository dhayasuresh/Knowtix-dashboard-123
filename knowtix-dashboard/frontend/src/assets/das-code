  transition: var(--transition);
}

.resource-link:hover {
  background-color: var(--primary-dark);
}

/* Settings Tab */
.settings-tab {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.section-header {
  margin-bottom: 1rem;
}

.section-header h2 {
  font-size: 1.5rem;
  font-weight: 700;
}

.settings-content {
  display: flex;
  flex-direction: column;
  gap: 2rem;
}

.settings-sections {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
  gap: 1.5rem;
}

.settings-card {
  padding: 1.5rem;
  border-radius: var(--border-radius);
  background-color: var(--light-card);
  box-shadow: var(--box-shadow);
}

