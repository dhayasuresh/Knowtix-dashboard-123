  overflow-y: auto;
  font-family: 'Courier New', monospace;
  font-size: 0.875rem;
  line-height: 1.5;
}

.dark .generated-content pre {
  background-color: var(--dark-bg);
}

/* Achievements Tab */
.achievements-tab {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.section-header {
  margin-bottom: 1rem;
}

.section-header h2 {
  font-size: 1.5rem;
  font-weight: 700;
}

.achievements-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
  gap: 1.5rem;
}

/* Resources Tab */
.study-resources-tab {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.section-header {
  margin-bottom: 1rem;
}

.section-header h2 {
  font-size: 1.5rem;
  font-weight: 700;
}

.resources-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 1.5rem;
}

.resource-card {
  padding: 1.5rem;
  border-radius: var(--border-radius);
  background-color: var(--light-card);
  box-shadow: var(--box-shadow);
  transition: var(--transition);
}

.dark .resource-card {
  background-color: var(--dark-card);
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
}

.resource-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
}

.dark .resource-card:hover {
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.4), 0 4px 6px -2px rgba(0, 0, 0, 0.2);
}

.resource-card h3 {
  font-size: 1.1rem;
  font-weight: 600;
  margin-bottom: 0.75rem;
}

.resource-card p {
  font-size: 0.875rem;
  color: #64748b;
  margin-bottom: 1.5rem;
}

.dark .resource-card p {
  color: #94a3b8;
}

.resource-link {
  display: inline-block;
  padding: 0.5rem 1rem;
  border-radius: var(--border-radius);
  background-color: var(--primary-color);
  color: white;
  font-weight: 500;
