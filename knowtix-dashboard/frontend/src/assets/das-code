/* Reset and Base Styles */
*,
*::before,
*::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

:root {
  --primary-color: #6366f1;
  --primary-dark: #4f46e5;
  --secondary-color: #10b981;
  --accent-color: #f59e0b;
  --danger-color: #ef4444;
  --dark-bg: #1e293b;
  --dark-card: #334155;
  --dark-text: #f1f5f9;
  --light-bg: #f8fafc;
  --light-card: #ffffff;
  --light-text: #1e293b;
  --border-radius: 12px;
  --box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

body {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  background-color: var(--light-bg);
  color: var(--light-text);
  line-height: 1.6;
  transition: var(--transition);
}

/* Dark Mode */
.dark {
  --light-bg: #0f172a;
  --light-card: #1e293b;
  --light-text: #f1f5f9;
  --dark-bg: #020617;
  --dark-card: #1e293b;
  --dark-text: #f1f5f9;
}

/* Dashboard Container */
.dashboard-container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  transition: var(--transition);
}

/* Header Styles */
.header {
  background-color: var(--light-card);
  box-shadow: var(--box-shadow);
  position: sticky;
  top: 0;
  z-index: 100;
  transition: var(--transition);
}

.dark .header {
  background-color: var(--dark-card);
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
}

.header-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1rem 1.5rem;
  max-width: 1400px;
  margin: 0 auto;
}

.header-logo {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  cursor: pointer;
  transition: var(--transition);
}

.header-logo:hover {
  transform: translateY(-2px);
}

.logo {
  height: 2.5rem;
  width: auto;
}

.header-title {
  font-size: 1.5rem;
  font-weight: 700;
  background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.header-search {
  flex: 1;
  max-width: 500px;
  margin: 0 2rem;
}

.search-container {
  position: relative;
}

.search-icon {
  position: absolute;
  left: 1rem;
  top: 50%;
  transform: translateY(-50%);
  color: #94a3b8;
}

.search-input {
  width: 100%;
  padding: 0.75rem 1rem 0.75rem 3rem;
  border-radius: var(--border-radius);
  border: 1px solid #e2e8f0;
  background-color: var(--light-bg);
  color: var(--light-text);
  font-size: 0.95rem;
  transition: var(--transition);
}

.dark .search-input {
  border-color: #334155;
  background-color: var(--dark-bg);
}

.search-input:focus {
  outline: none;
  border-color: var(--primary-color);
  box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.icon-button {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 2.5rem;
  height: 2.5rem;
  border-radius: 50%;
  background-color: transparent;
  border: none;
  color: #64748b;
  cursor: pointer;
  transition: var(--transition);
}

.icon-button:hover {
  background-color: rgba(99, 102, 241, 0.1);
  color: var(--primary-color);
}

.dark .icon-button:hover {
  background-color: rgba(99, 102, 241, 0.2);
}

.icon-button.recording {
  background-color: rgba(239, 68, 68, 0.1);
  color: var(--danger-color);
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0% {
    box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.4);
  }
  70% {
    box-shadow: 0 0 0 10px rgba(239, 68, 68, 0);
  }
  100% {
    box-shadow: 0 0 0 0 rgba(239, 68, 68, 0);
  }
}

.notification-badge {
  position: absolute;
  top: -5px;
  right: -5px;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 1.25rem;
  height: 1.25rem;
  border-radius: 50%;
  background-color: var(--danger-color);
  color: white;
  font-size: 0.75rem;
  font-weight: 600;
}

/* Dropdown Styles */
.notification-dropdown,
.user-popup {
  position: absolute;
  top: 100%;
  right: 0;
  margin-top: 0.5rem;
  width: 320px;
  border-radius: var(--border-radius);
  background-color: var(--light-card);
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
  z-index: 50;
  animation: slideDown 0.3s ease-out forwards;
  transform-origin: top right;
}

.dark .notification-dropdown,
.dark .user-popup {
  background-color: var(--dark-card);
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.3), 0 4px 6px -2px rgba(0, 0, 0, 0.2);
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.dropdown-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1rem;
  border-bottom: 1px solid #e2e8f0;
}

.dark .dropdown-header {
  border-color: #334155;
}

.notification-count {
  background-color: var(--primary-color);
  color: white;
  padding: 0.25rem 0.5rem;
  border-radius: 9999px;
  font-size: 0.75rem;
  font-weight: 600;
}

.notification-list {
  max-height: 400px;
  overflow-y: auto;
}

.notification-item {
  padding: 1rem;
  border-bottom: 1px solid #e2e8f0;
  transition: var(--transition);
}

.dark .notification-item {
  border-color: #334155;
}

.notification-item.unread {
  background-color: rgba(99, 102, 241, 0.05);
}

.dark .notification-item.unread {
  background-color: rgba(99, 102, 241, 0.1);
}

.notification-title {
  font-weight: 600;
  margin-bottom: 0.25rem;
}

.notification-description {
  font-size: 0.875rem;
  color: #64748b;
  margin-bottom: 0.5rem;
}

.dark .notification-description {
  color: #94a3b8;
}

.notification-date {
  font-size: 0.75rem;
  color: #94a3b8;
}

.notification-actions {
  display: flex;
  justify-content: flex-end;
  gap: 0.5rem;
  margin-top: 0.5rem;
}

.notification-action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 1.5rem;
  height: 1.5rem;
  border-radius: 50%;
  background-color: transparent;
  border: none;
  color: #64748b;
  cursor: pointer;
  transition: var(--transition);
}

.notification-action-btn:hover {
  background-color: rgba(99, 102, 241, 0.1);
  color: var(--primary-color);
}

.no-notifications {
  padding: 2rem 1rem;
  text-align: center;
  color: #94a3b8;
}

/* User Popup */
.user-info {
  display: flex;
  align-items: center;
  padding: 1.5rem;
  border-bottom: 1px solid #e2e8f0;
}

.dark .user-info {
  border-color: #334155;
}

.user-avatar {
  margin-right: 1rem;
}

.profile-pic {
  width: 3.5rem;
  height: 3.5rem;
  border-radius: 50%;
  object-fit: cover;
}

.user-details {
  flex: 1;
}

.user-name {
  font-weight: 600;
  font-size: 1.1rem;
  margin-bottom: 0.25rem;
}

.user-role {
  font-size: 0.875rem;
  color: #64748b;
}

.dark .user-role {
  color: #94a3b8;
}

.user-meta {
  padding: 1rem 1.5rem;
  border-bottom: 1px solid #e2e8f0;
}

.dark .user-meta {
  border-color: #334155;
}

.user-meta p {
  margin-bottom: 0.5rem;
  font-size: 0.875rem;
}

.user-meta p:last-child {
  margin-bottom: 0;
}

.user-meta strong {
  color: #64748b;
}

.dark .user-meta strong {
  color: #94a3b8;
}

.user-actions {
  padding: 1rem;
}

.user-action-btn {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  width: 100%;
  padding: 0.75rem 1rem;
  margin-bottom: 0.5rem;
  border-radius: var(--border-radius);
  background-color: transparent;
  border: 1px solid #e2e8f0;
  color: var(--light-text);
  font-size: 0.875rem;
  text-align: left;
  cursor: pointer;
  transition: var(--transition);
}

.dark .user-action-btn {
  border-color: #334155;
}

.user-action-btn:hover {
  background-color: rgba(99, 102, 241, 0.05);
  border-color: var(--primary-color);
}

.dark .user-action-btn:hover {
  background-color: rgba(99, 102, 241, 0.1);
}

.user-action-btn.logout {
  color: var(--danger-color);
  border-color: rgba(239, 68, 68, 0.3);
}

.user-action-btn.logout:hover {
  background-color: rgba(239, 68, 68, 0.05);
  border-color: var(--danger-color);
}

.dark .user-action-btn.logout {
  border-color: rgba(239, 68, 68, 0.2);
}

.dark .user-action-btn.logout:hover {
  background-color: rgba(239, 68, 68, 0.1);
}

/* Main Layout */
.main-layout {
  display: flex;
  flex: 1;
  max-width: 1400px;
  margin: 0 auto;
  width: 100%;
}

/* Sidebar */
.sidebar {
  width: 260px;
  background-color: var(--light-card);
  border-right: 1px solid #e2e8f0;
  padding: 1.5rem 0;
  overflow-y: auto;
  transition: var(--transition);
}

.dark .sidebar {
  background-color: var(--dark-card);
  border-color: #334155;
}

.sidebar-content {
  padding: 0 1rem;
}

.sidebar-title {
  font-size: 0.875rem;
  font-weight: 600;
  color: #64748b;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: 1rem;
  padding: 0 0.75rem;
}

.dark .sidebar-title {
  color: #94a3b8;
}

.sidebar-nav {
  margin-bottom: 2rem;
}

.nav-link {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.75rem 1rem;
  margin-bottom: 0.25rem;
  border-radius: var(--border-radius);
  background-color: transparent;
  border: none;
  color: #64748b;
  font-size: 0.95rem;
  text-align: left;
  cursor: pointer;
  transition: var(--transition);
  position: relative;
  overflow: hidden;
}

.dark .nav-link {
  color: #94a3b8;
}

.nav-link::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 4px;
  height: 100%;
  background-color: var(--primary-color);
  transform: translateX(-100%);
  transition: var(--transition);
}

.nav-link:hover {
  background-color: rgba(99, 102, 241, 0.05);
  color: var(--primary-color);
}

.dark .nav-link:hover {
  background-color: rgba(99, 102, 241, 0.1);
}

.nav-link.active {
  background-color: rgba(99, 102, 241, 0.1);
  color: var(--primary-color);
  font-weight: 600;
}

.dark .nav-link.active {
  background-color: rgba(99, 102, 241, 0.2);
}

.nav-link.active::before {
  transform: translateX(0);
}

.nav-link.logout {
  margin-top: 1rem;
  color: var(--danger-color);
}

.nav-link.logout:hover {
  background-color: rgba(239, 68, 68, 0.05);
}

.dark .nav-link.logout:hover {
  background-color: rgba(239, 68, 68, 0.1);
}

/* Sidebar Sections */
.sidebar-section {
  margin-bottom: 2rem;
}

.progress-stats {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.progress-item {
  background-color: var(--light-bg);
  border-radius: var(--border-radius);
  padding: 1rem;
  transition: var(--transition);
}

.dark .progress-item {
  background-color: var(--dark-bg);
}

.progress-label {
  font-size: 0.875rem;
  color: #64748b;
  margin-bottom: 0.5rem;
}

.dark .progress-label {
  color: #94a3b8;
}

.progress-bar {
  height: 8px;
  background-color: #e2e8f0;
  border-radius: 9999px;
  overflow: hidden;
  margin-bottom: 0.5rem;
}

.dark .progress-bar {
  background-color: #334155;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--primary-color), var(--secondary-color));
  border-radius: 9999px;
  transition: width 1s ease-out;
}

.progress-value {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--primary-color);
}

/* Quick Actions */
.quick-actions {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.quick-action-btn {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.75rem 1rem;
  border-radius: var(--border-radius);
  background-color: var(--light-bg);
  border: none;
  color: var(--light-text);
  font-size: 0.875rem;
  text-align: left;
  cursor: pointer;
  transition: var(--transition);
}

.dark .quick-action-btn {
  background-color: var(--dark-bg);
}

.quick-action-btn:hover {
  background-color: rgba(99, 102, 241, 0.1);
  transform: translateX(5px);
}

.dark .quick-action-btn:hover {
  background-color: rgba(99, 102, 241, 0.2);
}

/* Voice Status */
.voice-status {
  background-color: var(--light-bg);
  border-radius: var(--border-radius);
  padding: 1rem;
}

.dark .voice-status {
  background-color: var(--dark-bg);
}

.voice-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  width: 100%;
  padding: 0.75rem;
  border-radius: var(--border-radius);
  background-color: var(--primary-color);
  border: none;
  color: white;
  font-weight: 600;
  cursor: pointer;
  transition: var(--transition);
  margin-bottom: 1rem;
}

.voice-btn:hover {
  background-color: var(--primary-dark);
}

.voice-btn.listening {
  background-color: var(--danger-color);
  animation: pulse 1.5s infinite;
}

.voice-command {
  margin-top: 1rem;
  padding: 0.75rem;
  border-radius: var(--border-radius);
  background-color: rgba(99, 102, 241, 0.05);
  font-size: 0.875rem;
}

.dark .voice-command {
  background-color: rgba(99, 102, 241, 0.1);
}

.voice-commands-help {
  margin-top: 1rem;
}

.voice-commands-help p {
  font-size: 0.875rem;
  color: #64748b;
  margin-bottom: 0.5rem;
}

.dark .voice-commands-help p {
  color: #94a3b8;
}

.voice-commands-help ul {
  list-style-type: none;
  padding-left: 0.5rem;
}

.voice-commands-help li {
  font-size: 0.875rem;
  color: #64748b;
  margin-bottom: 0.25rem;
  padding-left: 1rem;
  position: relative;
}

.dark .voice-commands-help li {
  color: #94a3b8;
}

.voice-commands-help li::before {
  content: '•';
  position: absolute;
  left: 0;
  color: var(--primary-color);
}

/* Quick Resources */
.quick-resources {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.resource-item {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.75rem;
  border-radius: var(--border-radius);
  background-color: var(--light-bg);
  transition: var(--transition);
}

.dark .resource-item {
  background-color: var(--dark-bg);
}

.resource-item:hover {
  transform: translateX(5px);
}

.resource-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 2.5rem;
  height: 2.5rem;
  border-radius: var(--border-radius);
  background-color: rgba(99, 102, 241, 0.1);
  color: var(--primary-color);
}

.dark .resource-icon {
  background-color: rgba(99, 102, 241, 0.2);
}

.resource-info {
  flex: 1;
}

.resource-title {
  font-weight: 600;
  margin-bottom: 0.25rem;
}

.resource-count {
  font-size: 0.75rem;
  color: #64748b;
}

.dark .resource-count {
  color: #94a3b8;
}

/* Recent Files */
.recent-files {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.recent-file {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.75rem;
  border-radius: var(--border-radius);
  background-color: var(--light-bg);
  transition: var(--transition);
}

.dark .recent-file {
  background-color: var(--dark-bg);
}

.recent-file:hover {
  background-color: rgba(99, 102, 241, 0.05);
}

.dark .recent-file:hover {
  background-color: rgba(99, 102, 241, 0.1);
}

.file-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 2rem;
  height: 2rem;
  border-radius: var(--border-radius);
  background-color: rgba(99, 102, 241, 0.1);
  color: var(--primary-color);
}

.dark .file-icon {
  background-color: rgba(99, 102, 241, 0.2);
}

.file-info {
  flex: 1;
}

.file-name {
  font-weight: 500;
  font-size: 0.875rem;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 150px;
}

.file-size {
  font-size: 0.75rem;
  color: #64748b;
}

.dark .file-size {
  color: #94a3b8;
}

.file-action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 1.5rem;
  height: 1.5rem;
  border-radius: 50%;
  background-color: transparent;
  border: none;
  color: #64748b;
  cursor: pointer;
  transition: var(--transition);
}

.file-action-btn:hover {
  background-color: rgba(99, 102, 241, 0.1);
  color: var(--primary-color);
}

.no-files {
  padding: 1rem;
  text-align: center;
  color: #94a3b8;
  font-size: 0.875rem;
}

/* Main Content */
.dashboard-main {
  flex: 1;
  padding: 1.5rem;
  overflow-y: auto;
}

/* Welcome Card */
.welcome-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 2rem;
  border-radius: var(--border-radius);
  background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
  color: white;
  margin-bottom: 2rem;
  position: relative;
  overflow: hidden;
}

.welcome-content {
  position: relative;
  z-index: 2;
}

.welcome-content h1 {
  font-size: 2rem;
  font-weight: 700;
  margin-bottom: 0.5rem;
}

.welcome-content p {
  font-size: 1rem;
  opacity: 0.9;
  max-width: 600px;
}

.welcome-decoration {
  position: absolute;
  right: 2rem;
  top: 50%;
  transform: translateY(-50%);
}

.decoration-circle {
  width: 120px;
  height: 120px;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.1);
  position: absolute;
  animation: float 6s ease-in-out infinite;
}

.decoration-circle:nth-child(1) {
  right: 0;
  animation-delay: 0s;
}

.decoration-circle:nth-child(2) {
  right: 60px;
  width: 80px;
  height: 80px;
  animation-delay: 1s;
}

@keyframes float {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-20px);
  }
}

/* Stats Grid */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
  gap: 1.5rem;
  margin-bottom: 2rem;
}

.stat-card {
  padding: 1.5rem;
  border-radius: var(--border-radius);
  background-color: var(--light-card);
  box-shadow: var(--box-shadow);
  transition: var(--transition);
}

.dark .stat-card {
  background-color: var(--dark-card);
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
}

.stat-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
}

.dark .stat-card:hover {
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.4), 0 4px 6px -2px rgba(0, 0, 0, 0.2);
}

.stat-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.stat-info {
  flex: 1;
}

.stat-label {
  font-size: 0.875rem;
  color: #64748b;
  margin-bottom: 0.5rem;
}

.dark .stat-label {
  color: #94a3b8;
}

.stat-value {
  font-size: 2rem;
  font-weight: 700;
  margin-bottom: 0.5rem;
}

.stat-change {
  font-size: 0.875rem;
  display: flex;
  align-items: center;
  gap: 0.25rem;
}

.stat-change.positive {
  color: var(--secondary-color);
}

.stat-change.negative {
  color: var(--danger-color);
}

.stat-change.neutral {
  color: var(--accent-color);
}

.stat-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 3rem;
  height: 3rem;
  border-radius: var(--border-radius);
  font-size: 1.5rem;
}

.stat-icon.blue {
  background-color: rgba(99, 102, 241, 0.1);
  color: var(--primary-color);
}

.dark .stat-icon.blue {
  background-color: rgba(99, 102, 241, 0.2);
}

.stat-icon.green {
  background-color: rgba(16, 185, 129, 0.1);
  color: var(--secondary-color);
}

.dark .stat-icon.green {
  background-color: rgba(16, 185, 129, 0.2);
}

.stat-icon.orange {
  background-color: rgba(245, 158, 11, 0.1);
  color: var(--accent-color);
}

.dark .stat-icon.orange {
  background-color: rgba(245, 158, 11, 0.2);
}

.stat-icon.purple {
  background-color: rgba(139, 92, 246, 0.1);
  color: #8b5cf6;
}

.dark .stat-icon.purple {
  background-color: rgba(139, 92, 246, 0.2);
}

/* Charts Grid */
.charts-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
  gap: 1.5rem;
  margin-bottom: 2rem;
}

.chart-card {
  padding: 1.5rem;
  border-radius: var(--border-radius);
  background-color: var(--light-card);
  box-shadow: var(--box-shadow);
  transition: var(--transition);
}

.dark .chart-card {
  background-color: var(--dark-card);
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
}

.chart-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 1.5rem;
}

.chart-header h3 {
  font-size: 1.1rem;
  font-weight: 600;
}

.chart-actions {
  display: flex;
  align-items: center;
}

.chart-action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 2rem;
  height: 2rem;
  border-radius: 50%;
  background-color: transparent;
  border: none;
  color: #64748b;
  cursor: pointer;
  transition: var(--transition);
}

.chart-action-btn:hover {
  background-color: rgba(99, 102, 241, 0.1);
  color: var(--primary-color);
}

.chart-container {
  height: 250px;
  position: relative;
}

/* Features Section */
.features-section {
  margin-bottom: 2rem;
}

.section-title {
  font-size: 1.5rem;
  font-weight: 700;
  margin-bottom: 1.5rem;
}

/* Document Analysis */
.document-analysis {
  padding: 1.5rem;
  border-radius: var(--border-radius);
  background-color: var(--light-card);
  box-shadow: var(--box-shadow);
  margin-bottom: 2rem;
}

.dark .document-analysis {
  background-color: var(--dark-card);
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
}

.analysis-header {
  margin-bottom: 1.5rem;
}

.analysis-header h3 {
  font-size: 1.25rem;
  font-weight: 600;
  margin-bottom: 0.5rem;
}

.analysis-header p {
  color: #64748b;
}

.dark .analysis-header p {
  color: #94a3b8;
}

.document-types {
  margin-bottom: 2rem;
}

.document-types h4 {
  font-size: 1rem;
  font-weight: 600;
  margin-bottom: 1rem;
}

.types-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 1rem;
}

.document-type {
  padding: 1rem;
  border-radius: var(--border-radius);
  background-color: var(--light-bg);
  transition: var(--transition);
}

.dark .document-type {
  background-color: var(--dark-bg);
}

.document-type:hover {
  transform: translateY(-3px);
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
}

.dark .document-type:hover {
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
}

.type-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 3rem;
  height: 3rem;
  border-radius: var(--border-radius);
  background-color: rgba(99, 102, 241, 0.1);
  color: var(--primary-color);
  margin-bottom: 1rem;
  font-size: 1.5rem;
}

.dark .type-icon {
  background-color: rgba(99, 102, 241, 0.2);
}

.document-type h5 {
  font-size: 1rem;
  font-weight: 600;
  margin-bottom: 0.5rem;
}

.document-type p {
  font-size: 0.875rem;
  color: #64748b;
}

.dark .document-type p {
  color: #94a3b8;
}

.upload-section {
  margin-bottom: 2rem;
}

.file-upload-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.75rem 1.5rem;
  border-radius: var(--border-radius);
  background-color: var(--primary-color);
  color: white;
  font-weight: 600;
  cursor: pointer;
  transition: var(--transition);
  margin-bottom: 0.5rem;
}

.file-upload-btn:hover {
  background-color: var(--primary-dark);
}

.upload-info {
  font-size: 0.875rem;
  color: #64748b;
}

.dark .upload-info {
  color: #94a3b8;
}

.analysis-progress {
  margin-top: 1rem;
}

.progress-bar {
  height: 8px;
  background-color: #e2e8f0;
  border-radius: 9999px;
  overflow: hidden;
  margin-bottom: 0.5rem;
}

.dark .progress-bar {
  background-color: #334155;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--primary-color), var(--secondary-color));
  border-radius: 9999px;
  width: 70%;
  animation: progressAnimation 2s ease-out infinite;
}

@keyframes progressAnimation {
  0% {
    width: 30%;
  }
  50% {
    width: 70%;
  }
  100% {
    width: 30%;
  }
}

.analysis-progress p {
  font-size: 0.875rem;
  color: #64748b;
  text-align: center;
}

.dark .analysis-progress p {
  color: #94a3b8;
}

.extracted-topics {
  margin-top: 2rem;
}

.extracted-topics h4 {
  font-size: 1rem;
  font-weight: 600;
  margin-bottom: 1rem;
}

.topics-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 1rem;
}

.topic-card {
  padding: 1rem;
  border-radius: var(--border-radius);
  background-color: var(--light-bg);
  cursor: pointer;
  transition: var(--transition);
}

.dark .topic-card {
  background-color: var(--dark-bg);
}

.topic-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
}

.dark .topic-card:hover {
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
}

.topic-card h5 {
  font-size: 1rem;
  font-weight: 600;
  margin-bottom: 0.5rem;
}

.topic-card p {
  font-size: 0.875rem;
  color: #64748b;
  margin-bottom: 1rem;
}

.dark .topic-card p {
  color: #94a3b8;
}

.topic-actions {
  display: flex;
  gap: 0.5rem;
}

.topic-actions span {
  padding: 0.25rem 0.5rem;
  border-radius: 9999px;
  background-color: rgba(99, 102, 241, 0.1);
  color: var(--primary-color);
  font-size: 0.75rem;
  font-weight: 500;
  cursor: pointer;
  transition: var(--transition);
}

.dark .topic-actions span {
  background-color: rgba(99, 102, 241, 0.2);
}

.topic-actions span:hover {
  background-color: var(--primary-color);
  color: white;
}

/* Section Container */
.section-container {
  margin-bottom: 2rem;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 1.5rem;
}

.section-header h2 {
  font-size: 1.5rem;
  font-weight: 700;
}

.secondary-btn {
  padding: 0.5rem 1rem;
  border-radius: var(--border-radius);
  background-color: transparent;
  border: 1px solid #e2e8f0;
  color: var(--light-text);
  font-size: 0.875rem;
  font-weight: 500;
  cursor: pointer;
  transition: var(--transition);
}

.dark .secondary-btn {
  border-color: #334155;
}

.secondary-btn:hover {
  background-color: rgba(99, 102, 241, 0.05);
  border-color: var(--primary-color);
}

.dark .secondary-btn:hover {
  background-color: rgba(99, 102, 241, 0.1);
}

/* Achievements Grid */
.achievements-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
  gap: 1.5rem;
}

.achievement-card {
  padding: 1.5rem;
  border-radius: var(--border-radius);
  background-color: var(--light-card);
  box-shadow: var(--box-shadow);
  text-align: center;
  transition: var(--transition);
  position: relative;
  overflow: hidden;
}

.dark .achievement-card {
  background-color: var(--dark-card);
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
}

.achievement-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 4px;
  background: linear-gradient(90deg, var(--primary-color), var(--secondary-color));
}

.achievement-card.locked {
  opacity: 0.7;
}

.achievement-card.locked::before {
  background: #94a3b8;
}

.achievement-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 4rem;
  height: 4rem;
  border-radius: 50%;
  background-color: rgba(99, 102, 241, 0.1);
  color: var(--primary-color);
  font-size: 2rem;
  margin: 0 auto 1rem;
}

.dark .achievement-icon {
  background-color: rgba(99, 102, 241, 0.2);
}

.achievement-card.locked .achievement-icon {
  background-color: rgba(148, 163, 184, 0.1);
  color: #94a3b8;
}

.dark .achievement-card.locked .achievement-icon {
  background-color: rgba(148, 163, 184, 0.2);
}

.achievement-card h3 {
  font-size: 1.1rem;
  font-weight: 600;
  margin-bottom: 0.5rem;
}

.achievement-card p {
  font-size: 0.875rem;
  color: #64748b;
  margin-bottom: 1rem;
}

.dark .achievement-card p {
  color: #94a3b8;
}

.achievement-status {
  display: inline-block;
  padding: 0.25rem 0.75rem;
  border-radius: 9999px;
  font-size: 0.75rem;
  font-weight: 600;
}

.status-unlocked {
  background-color: rgba(16, 185, 129, 0.1);
  color: var(--secondary-color);
}

.dark .status-unlocked {
  background-color: rgba(16, 185, 129, 0.2);
}

.status-locked {
  background-color: rgba(148, 163, 184, 0.1);
  color: #94a3b8;
}

.dark .status-locked {
  background-color: rgba(148, 163, 184, 0.2);
}

/* Content Grid */
.content-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 1.5rem;
  margin-bottom: 2rem;
}

.content-card {
  padding: 1.5rem;
  border-radius: var(--border-radius);
  background-color: var(--light-card);
  box-shadow: var(--box-shadow);
  transition: var(--transition);
}

.dark .content-card {
  background-color: var(--dark-card);
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
}

.content-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
}

.dark .content-card:hover {
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.4), 0 4px 6px -2px rgba(0, 0, 0, 0.2);
}

.card-header {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 1rem;
}

.card-header h3 {
  font-size: 1.1rem;
  font-weight: 600;
}

.header-icon {
  color: var(--primary-color);
}

/* Calendar */
.calendar-wrapper {
  margin-bottom: 1rem;
}

.custom-calendar {
  width: 100%;
  border: none;
  background-color: transparent;
}

.custom-calendar .react-calendar__navigation {
  display: flex;
  height: 44px;
  margin-bottom: 1rem;
}

.custom-calendar .react-calendar__navigation button {
  flex-grow: 1;
  color: var(--light-text);
  min-width: 44px;
  background: none;
  font-size: 16px;
  margin-top: 8px;
}

.custom-calendar .react-calendar__navigation button:enabled:hover,
.custom-calendar .react-calendar__navigation button:enabled:focus {
  background-color: rgba(99, 102, 241, 0.1);
}

.custom-calendar .react-calendar__month-view__weekdays {
  text-align: center;
  text-transform: uppercase;
  font-weight: 600;
  font-size: 0.75rem;
  color: #64748b;
}

.custom-calendar .react-calendar__month-view__weekdays__weekday {
  padding: 0.5rem 0;
}

.custom-calendar .react-calendar__month-view__days__day {
  position: relative;
  padding: 0.5rem;
  border-radius: var(--border-radius);
  transition: var(--transition);
}

.custom-calendar .react-calendar__month-view__days__day:hover {
  background-color: rgba(99, 102, 241, 0.05);
}

.dark .custom-calendar .react-calendar__month-view__days__day:hover {
  background-color: rgba(99, 102, 241, 0.1);
}

.custom-calendar .react-calendar__month-view__days__day--weekend {
  color: #94a3b8;
}

.custom-calendar .react-calendar__month-view__days__day--neighboringMonth {
  color: #cbd5e1;
}

.custom-calendar .react-calendar__month-view__days__day--active {
  background-color: var(--primary-color);
  color: white;
}

.custom-calendar .react-calendar__tile--now {
  background-color: rgba(99, 102, 241, 0.1);
  color: var(--primary-color);
  font-weight: 600;
}

.dark .custom-calendar .react-calendar__tile--now {
  background-color: rgba(99, 102, 241, 0.2);
}

.custom-calendar .react-calendar__tile--hasActive {
  background-color: var(--primary-color);
  color: white;
}

.calendar-tasks {
  position: absolute;
  bottom: 2px;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  gap: 2px;
}

.calendar-event-dot,
.calendar-task-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
}

.calendar-event-dot {
  background-color: #ef4444;
}

.calendar-task-dot {
  background-color: var(--primary-color);
}

/* Materials List */
.materials-list {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.material-item {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.75rem;
  border-radius: var(--border-radius);
  background-color: var(--light-bg);
  transition: var(--transition);
}

.dark .material-item {
  background-color: var(--dark-bg);
}

.material-item:hover {
  background-color: rgba(99, 102, 241, 0.05);
}

.dark .material-item:hover {
  background-color: rgba(99, 102, 241, 0.1);
}

.material-icon.blue {
  color: var(--primary-color);
}

.material-icon.red {
  color: var(--danger-color);
}

.material-icon.green {
  color: var(--secondary-color);
}

.material-info {
  flex: 1;
}

.material-title {
  font-weight: 500;
  font-size: 0.875rem;
  margin-bottom: 0.25rem;
}

.material-meta {
  font-size: 0.75rem;
  color: #64748b;
}

.dark .material-meta {
  color: #94a3b8;
}

.empty-state {
  padding: 2rem;
  text-align: center;
  color: #94a3b8;
}

/* Exams List */
.exams-list {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.exam-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1rem;
  border-radius: var(--border-radius);
  background-color: var(--light-bg);
  transition: var(--transition);
}

.dark .exam-item {
  background-color: var(--dark-bg);
}

.exam-item:hover {
  background-color: rgba(99, 102, 241, 0.05);
}

.dark .exam-item:hover {
  background-color: rgba(99, 102, 241, 0.1);
}

.exam-info {
  flex: 1;
}

.exam-subject {
  font-weight: 600;
  margin-bottom: 0.25rem;
}

.exam-type {
  font-size: 0.875rem;
  color: #64748b;
  margin-bottom: 0.25rem;
}

.dark .exam-type {
  color: #94a3b8;
}

.exam-date {
  font-size: 0.875rem;
  color: #64748b;
}

.dark .exam-date {
  color: #94a3b8;
}

.exam-status {
  display: flex;
  align-items: center;
}

.status-badge {
  padding: 0.25rem 0.75rem;
  border-radius: 9999px;
  font-size: 0.75rem;
  font-weight: 600;
}

.status-badge.upcoming {
  background-color: rgba(245, 158, 11, 0.1);
  color: var(--accent-color);
}

.dark .status-badge.upcoming {
  background-color: rgba(245, 158, 11, 0.2);
}

/* Materials Tab */
.materials-tab {
  display: flex;
  flex-direction: column;
  gap: 2rem;
}

/* File Explorer */
.materials-content {
  padding: 1.5rem;
  border-radius: var(--border-radius);
  background-color: var(--light-card);
  box-shadow: var(--box-shadow);
}

.dark .materials-content {
  background-color: var(--dark-card);
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
}

.file-explorer {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.explorer-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 1rem;
  border-bottom: 1px solid #e2e8f0;
}

.dark .explorer-header {
  border-color: #334155;
}

.breadcrumb {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.breadcrumb button {
  background: none;
  border: none;
  color: var(--primary-color);
  font-weight: 500;
  cursor: pointer;
  transition: var(--transition);
}

.breadcrumb button:hover {
  text-decoration: underline;
}

.breadcrumb span {
  color: #64748b;
}

.dark .breadcrumb span {
  color: #94a3b8;
}

.explorer-actions {
  display: flex;
  gap: 0.5rem;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem 1rem;
  border-radius: var(--border-radius);
  background-color: var(--primary-color);
  color: white;
  font-size: 0.875rem;
  font-weight: 500;
  cursor: pointer;
  transition: var(--transition);
  border: none;
}

.action-btn:hover {
  background-color: var(--primary-dark);
}

.action-btn.close {
  background-color: transparent;
  color: #64748b;
  padding: 0.5rem;
}

.action-btn.close:hover {
  background-color: rgba(239, 68, 68, 0.1);
  color: var(--danger-color);
}

.create-item {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 1rem;
}

.create-item input {
  flex: 1;
  padding: 0.5rem 1rem;
  border-radius: var(--border-radius);
  border: 1px solid #e2e8f0;
  background-color: var(--light-bg);
  color: var(--light-text);
  font-size: 0.875rem;
}

.dark .create-item input {
  border-color: #334155;
  background-color: var(--dark-bg);
}

.create-item input:focus {
  outline: none;
  border-color: var(--primary-color);
  box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
}

.create-actions {
  display: flex;
  gap: 0.5rem;
}

.create-actions button {
  padding: 0.5rem 1rem;
  border-radius: var(--border-radius);
  background-color: var(--primary-color);
  color: white;
  font-size: 0.875rem;
  font-weight: 500;
  cursor: pointer;
  transition: var(--transition);
  border: none;
}

.create-actions button:hover {
  background-color: var(--primary-dark);
}

.create-actions button:last-child {
  background-color: transparent;
  color: #64748b;
  border: 1px solid #e2e8f0;
}

.dark .create-actions button:last-child {
  border-color: #334155;
}

.create-actions button:last-child:hover {
  background-color: rgba(239, 68, 68, 0.1);
  color: var(--danger-color);
}

.explorer-content {
  display: flex;
  flex-direction: column;
  gap: 2rem;
}

.folders-section,
.files-section {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.folders-section h3,
.files-section h3 {
  font-size: 1.1rem;
  font-weight: 600;
  margin-bottom: 0.5rem;
}

.folders-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 1rem;
}

.folder-item {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 1rem;
  border-radius: var(--border-radius);
  background-color: var(--light-bg);
  transition: var(--transition);
}

.dark .folder-item {
  background-color: var(--dark-bg);
}

.folder-item:hover {
  background-color: rgba(99, 102, 241, 0.05);
  transform: translateY(-3px);
}

.dark .folder-item:hover {
  background-color: rgba(99, 102, 241, 0.1);
}

.folder-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 3rem;
  height: 3rem;
  border-radius: var(--border-radius);
  background-color: rgba(99, 102, 241, 0.1);
  color: var(--primary-color);
  font-size: 1.5rem;
}

.dark .folder-icon {
  background-color: rgba(99, 102, 241, 0.2);
}

.folder-info {
