.empty-column {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 2rem;
  text-align: center;
  color: #94a3b8;
  font-size: 0.875rem;
}

.empty-add-btn {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem 1rem;
  border-radius: var(--border-radius);
  background-color: var(--primary-color);
  color: white;
  font-weight: 500;
  cursor: pointer;
  transition: var(--transition);
  border: none;
  margin-top: 1rem;
}

.empty-add-btn:hover {
  background-color: var(--primary-dark);
}

/* Modals */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 1rem;
  animation: fadeIn 0.3s ease-out forwards;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.modal-content {
  background-color: var(--light-card);
  border-radius: var(--border-radius);
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  max-width: 500px;
  width: 100%;
  max-height: 90vh;
  overflow-y: auto;
  animation: slideUp 0.3s ease-out forwards;
}

.dark .modal-content {
  background-color: var(--dark-card);
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3), 0 10px 10px -5px rgba(0, 0, 0, 0.2);
}

.modal-content.large {
  max-width: 800px;
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1.5rem;
  border-bottom: 1px solid #e2e8f0;
}

.dark .modal-header {
  border-color: #334155;
}

.modal-header h3 {
  font-size: 1.25rem;
  font-weight: 600;
}

.close-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 2rem;
  height: 2rem;
  border-radius: 50%;
  background-color: transparent;
  border: none;
  color: #64748b;
  cursor: pointer;
  transition: var(--transition);
}

.close-btn:hover {
  background-color: rgba(239, 68, 68, 0.1);
  color: var(--danger-color);
}

.modal-body {
  padding: 1.5rem;
}

.modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 1rem;
  padding: 1.5rem;
  border-top: 1px solid #e2e8f0;
}

.dark .modal-actions {
  border-color: #334155;
}

.marks-options,
.type-options,
.topic-options {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
  gap: 1rem;
}

.mark-option-btn,
.type-option-btn,
.topic-option-btn {
  padding: 1rem;
  border-radius: var(--border-radius);
  background-color: var(--light-bg);
  border: none;
  color: var(--light-text);
  font-size: 0.875rem;
  font-weight: 500;
  cursor: pointer;
  transition: var(--transition);
  text-align: center;
}

.dark .mark-option-btn,
.dark .type-option-btn,
.dark .topic-option-btn {
  background-color: var(--dark-bg);
}

.mark-option-btn:hover,
.type-option-btn:hover,
.topic-option-btn:hover {
  background-color: rgba(99, 102, 241, 0.05);
  transform: translateY(-3px);
}

.dark .mark-option-btn:hover,
.dark .type-option-btn:hover,
.dark .topic-option-btn:hover {
  background-color: rgba(99, 102, 241, 0.1);
}

.topic-option-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
}

/* Study Material Generator */
.study-material-generator {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.material-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.material-header h3 {
  font-size: 1.25rem;
  font-weight: 600;
}

.material-actions {
  display: flex;
  gap: 0.5rem;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem 1rem;
  border-radius: var(--border-radius);
  background-color: var(--primary-color);
  color: white;
  font-size: 0.875rem;
  font-weight: 500;
  cursor: pointer;
  transition: var(--transition);
  border: none;
}

.action-btn:hover {
  background-color: var(--primary-dark);
}

.action-btn.close {
  background-color: transparent;
  color: #64748b;
  padding: 0.5rem;
}

.action-btn.close:hover {
  background-color: rgba(239, 68, 68, 0.1);
  color: var(--danger-color);
}

.material-content {
  padding: 1.5rem;
  border-radius: var(--border-radius);
  background-color: var(--light-bg);
  max-height: 400px;
  overflow-y: auto;
}

.dark .material-content {
  background-color: var(--dark-bg);
}

.material-content pre {
  font-family: 'Courier New', monospace;
  font-size: 0.875rem;
  line-height: 1.5;
  white-space: pre-wrap;
  word-wrap: break-word;
}

.material-options {
  margin-top: 1.5rem;
}

.material-options h4 {
  font-size: 1rem;
  font-weight: 600;
  margin-bottom: 1rem;
}

.options-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 1rem;
}

.option-card {
  padding: 1rem;
  border-radius: var(--border-radius);
  background-color: var(--light-bg);
  transition: var(--transition);
}

.dark .option-card {
  background-color: var(--dark-bg);
}

.option-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
}

.dark .option-card:hover {
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
}

.option-card h5 {
  font-size: 1rem;
  font-weight: 600;
  margin-bottom: 0.5rem;
}

.option-card p {
  font-size: 0.875rem;
  color: #64748b;
  margin-bottom: 1rem;
}

.dark .option-card p {
  color: #94a3b8;
}

.option-btn {
  width: 100%;
  padding: 0.5rem;
  border-radius: var(--border-radius);
  background-color: var(--primary-color);
  color: white;
  font-size: 0.875rem;
  font-weight: 500;
  cursor: pointer;
  transition: var(--transition);
  border: none;
}

.option-btn:hover {
  background-color: var(--primary-dark);
}

/* File Preview */
.file-preview {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.preview-image {
  max-width: 100%;
  max-height: 500px;
  object-fit: contain;
  border-radius: var(--border-radius);
}

.preview-pdf {
  width: 100%;
  height: 500px;
  border-radius: var(--border-radius);
  border: none;
}

.preview-text {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
  padding: 2rem;
}

.download-btn {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.75rem 1.5rem;
  border-radius: var(--border-radius);
  background-color: var(--primary-color);
  color: white;
  font-weight: 600;
  cursor: pointer;
  transition: var(--transition);
  border: none;
}

.download-btn:hover {
  background-color: var(--primary-dark);
}

/* Event Modal */
.form-group {
  margin-bottom: 1rem;
}

.form-group label {
  display: block;
  font-size: 0.875rem;
  color: #64748b;
  margin-bottom: 0.5rem;
}

.dark .form-group label {
  color: #94a3b8;
}

.form-group input,
.form-group select {
  width: 100%;
  padding: 0.75rem 1rem;
  border-radius: var(--border-radius);
  border: 1px solid #e2e8f0;
  background-color: var(--light-bg);
  color: var(--light-text);
  font-size: 0.875rem;
}

.dark .form-group input,
.dark .form-group select {
  border-color: #334155;
  background-color: var(--dark-bg);
}

.form-group input:focus,
.form-group select:focus {
  outline: none;
  border-color: var(--primary-color);
  box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
}

/* Toast Notifications */
.toast-container {
  position: fixed;
  top: 1rem;
  right: 1rem;
  z-index: 2000;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  max-width: 400px;
}

.toast-notification {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 1rem;
  border-radius: var(--border-radius);
  background-color: var(--light-card);
  box-shadow: var(--box-shadow);
  animation: slideInRight 0.3s ease-out forwards;
}

.dark .toast-notification {
  background-color: var(--dark-card);
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
}

@keyframes slideInRight {
  from {
    opacity: 0;
    transform: translateX(100%);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.toast-show {
  opacity: 1;
  transform: translateX(0);
}

.toast-hide {
  opacity: 0;
  transform: translateX(100%);
}

.toast-icon {
  font-size: 1.25rem;
}

.toast-success {
  border-left: 4px solid var(--secondary-color);
}

.toast-success .toast-icon {
  color: var(--secondary-color);
}

.toast-error {
  border-left: 4px solid var(--danger-color);
}

.toast-error .toast-icon {
  color: var(--danger-color);
}

.toast-warning {
  border-left: 4px solid var(--accent-color);
}

.toast-warning .toast-icon {
  color: var(--accent-color);
}

.toast-info {
  border-left: 4px solid var(--primary-color);
}

.toast-info .toast-icon {
  color: var(--primary-color);
}

.toast-message {
  flex: 1;
  font-size: 0.875rem;
}

.toast-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 1.5rem;
  height: 1.5rem;
  border-radius: 50%;
  background-color: transparent;
  border: none;
  color: #64748b;
  cursor: pointer;
  transition: var(--transition);
}

.toast-close:hover {
  background-color: rgba(239, 68, 68, 0.1);
  color: var(--danger-color);
}

/* Responsive Styles */
@media (max-width: 1024px) {
  .main-layout {
    flex-direction: column;
  }
  
  .sidebar {
    width: 100%;
    border-right: none;
    border-bottom: 1px solid #e2e8f0;
    max-height: 300px;
    overflow-y: auto;
  }
  
  .dark .sidebar {
    border-color: #334155;
  }
  
  .dashboard-main {
    padding: 1rem;
  }
  
  .stats-grid,
  .charts-grid,
  .content-grid,
  .achievements-grid,
  .resources-grid,
  .rooms-grid,
  .tools-grid,
  .timer-container,
  .math-tools-container,
  .settings-sections,
  .task-board {
    grid-template-columns: 1fr;
  }
  
  .calendar-full-view,
  .collaboration-content {
    grid-template-columns: 1fr;
  }
  
  .header-search {
    margin: 0 1rem;
  }
  
  .header-actions {
    gap: 0.5rem;
  }
  
  .icon-button {
    width: 2rem;
    height: 2rem;
  }
  
  .notification-dropdown,
  .user-popup {
    width: 280px;
  }
  
  .welcome-card {
    padding: 1.5rem;
  }
  
  .welcome-content h1 {
    font-size: 1.5rem;
  }
  
  .decoration-circle {
    display: none;
  }
}

@media (max-width: 768px) {
  .header-content {
    padding: 1rem;
  }
  
  .header-search {
    display: none;
  }
  
  .header-logo {
    gap: 0.5rem;
  }
  
  .logo {
    height: 2rem;
  }
  
  .header-title {
    font-size: 1.25rem;
  }
  
  .dashboard-main {
    padding: 0.75rem;
  }
  
  .welcome-card {
    padding: 1rem;
    flex-direction: column;
    text-align: center;
  }
  
  .welcome-content h1 {
    font-size: 1.25rem;
  }
  
  .stat-card {
    padding: 1rem;
  }
  
  .stat-value {
    font-size: 1.5rem;
  }
  
  .stat-icon {
    width: 2.5rem;
    height: 2.5rem;
    font-size: 1.25rem;
  }
  
  .chart-card,
  .content-card,
  .document-analysis,
  .section-container,
  .task-management,
  .modal-content {
    padding: 1rem;
  }
  
  .chart-container {
    height: 200px;
  }
  
  .section-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }
  
  .section-actions {
    width: 100%;
  }
  
  .start-quiz-btn,
  .add-question-btn,
  .add-event-btn,
  .add-task-btn,
  .generate-btn {
    width: 100%;
    justify-content: center;
  }
  
  .quiz-options,
  .task-actions,
  .modal-actions {
    flex-direction: column;
  }
  
  .quiz-option,
  .action-btn,
  .modal-actions button {
    width: 100%;
  }
  
  .timer-display,
  .stopwatch-display {
    font-size: 3rem;
  }
  
  .timer-controls,
  .stopwatch-controls {
    flex-wrap: wrap;
  }
  
  .timer-btn,
  .stopwatch-btn {
    flex: 1;
    min-width: 100px;
  }
  
  .preset-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  
  .shapes-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  
  .file-explorer,
  .calendar-details,
  .room-creator,
  .subject-selector,
  .note-creator,
  .editor-controls {
    flex-direction: column;
  }
  
  .explorer-header,
  .breadcrumb {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }
  
  .explorer-actions,
  .note-creator,
  .editor-controls {
    width: 100%;
  }
  
  .file-upload-btn,
  .action-btn {
    width: 100%;
    justify-content: center;
  }
  
  .notes-grid,
  .folders-grid,
  .files-list {
    grid-template-columns: 1fr;
  }
  
  .sticky-note {
    padding: 1rem;
  }
  
  .task-item {
    padding: 0.75rem;
  }
  
  .move-actions {
    justify-content: center;
  }
  
  .modal-content.large {
    max-width: 100%;
  }
  
  .toast-container {
    left: 1rem;
    right: 1rem;
    max-width: none;
  }
}

@media (max-width: 480px) {
  .stats-grid,
  .charts-grid,
  .content-grid,
  .achievements-grid,
  .resources-grid,
  .rooms-grid,
  .tools-grid,
  .timer-container,
  .math-tools-container,
  .settings-sections,
  .task-board,
  .marks-options,
  .type-options,
  .topic-options,
  .options-grid,
  .preset-grid {
    grid-template-columns: 1fr;
  }
  
  .header-content {
    padding: 0.75rem;
  }
  
  .header-title {
    font-size: 1rem;
  }
  
  .icon-button {
    width: 1.75rem;
    height: 1.75rem;
  }
  
  .notification-badge {
    width: 1rem;
    height: 1rem;
    font-size: 0.625rem;
  }
  
  .dashboard-main {
    padding: 0.5rem;
  }
  
  .welcome-card {
    padding: 0.75rem;
  }
  
  .welcome-content h1 {
    font-size: 1.125rem;
  }
  
  .stat-card {
    padding: 0.75rem;
  }
  
  .stat-value {
    font-size: 1.25rem;
  }
  
  .stat-icon {
    width: 2rem;
    height: 2rem;
    font-size: 1rem;
  }
  
  .chart-card,
  .content-card,
  .document-analysis,
  .section-container,
  .task-management,
  .modal-content {
    padding: 0.75rem;
  }
  
  .chart-container {
    height: 150px;
  }
  
  .section-header h2 {
    font-size: 1.25rem;
  }
  
  .section-header h3 {
    font-size: 1rem;
  }
  
  .quiz-option,
  .task-item,
  .sticky-note,
  .resource-card,
  .room-card,
  .tool-card,
  .shape-card,
  .setting-item,
  .option-card {
    padding: 0.75rem;
  }
  
  .timer-display,
  .stopwatch-display {
    font-size: 2.5rem;
  }
  
  .timer-btn,
  .stopwatch-btn {
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
  }
  
  .modal-header,
  .modal-body,
  .modal-actions {
    padding: 1rem;
  }
  
  .modal-header h3 {
    font-size: 1.125rem;
  }
  
  .material-content {
    padding: 1rem;
    max-height: 300px;
  }
  
  .toast-notification {
    padding: 0.75rem;
  }
  
  .toast-icon {
    font-size: 1rem;
  }
  
  .toast-message {
    font-size: 0.75rem;
  }
}