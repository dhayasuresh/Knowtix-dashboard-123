  margin-bottom: 1rem;
}

.settings-form {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.form-group label {
  font-size: 0.875rem;
  color: #64748b;
}

.dark .form-group label {
  color: #94a3b8;
}

.form-group input {
  padding: 0.75rem 1rem;
  border-radius: var(--border-radius);
  border: 1px solid #e2e8f0;
  background-color: var(--light-bg);
  color: var(--light-text);
  font-size: 0.875rem;
}

.dark .form-group input {
  border-color: #334155;
  background-color: var(--dark-bg);
}

.form-group input:focus {
  outline: none;
  border-color: var(--primary-color);
  box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
}

.form-help {
  font-size: 0.75rem;
  color: #94a3b8;
  margin-top: 0.25rem;
}

.save-settings-btn {
  padding: 0.75rem 1.5rem;
  border-radius: var(--border-radius);
  background-color: var(--primary-color);
  color: white;
  font-weight: 600;
  cursor: pointer;
  transition: var(--transition);
  border: none;
  align-self: flex-start;
}

.save-settings-btn:hover {
  background-color: var(--primary-dark);
}

.login-details {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.detail-item {
  display: flex;
  justify-content: space-between;
  padding-bottom: 0.75rem;
  border-bottom: 1px solid #e2e8f0;
}

.dark .detail-item {
  border-color: #334155;
}

.detail-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.detail-label {
  font-size: 0.875rem;
  color: #64748b;
}

.dark .detail-label {
  color: #94a3b8;
}

.detail-value {
  font-size: 0.875rem;
  font-weight: 500;
}

.sessions-list {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  margin-top: 0.5rem;
}

.session-item {
  display: flex;
  justify-content: space-between;
  font-size: 0.75rem;
}

.session-date {
  color: #64748b;
}

.dark .session-date {
  color: #94a3b8;
}

.session-duration {
  font-weight: 500;
}

.ratings-section {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.rating-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.rating-stars {
  display: flex;
  gap: 0.25rem;
}

.star-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 1.5rem;
  height: 1.5rem;
  border-radius: 50%;
  background-color: transparent;
  border: none;
  color: #cbd5e1;
  cursor: pointer;
  transition: var(--transition);
}

.star-btn:hover {
  color: var(--accent-color);
}

.star-btn.active {
  color: var(--accent-color);
}

.scores-list {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  max-height: 300px;
  overflow-y: auto;
}

.score-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.75rem;
  border-radius: var(--border-radius);
  background-color: var(--light-bg);
}

.dark .score-item {
  background-color: var(--dark-bg);
}

.score-info {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.score-subject {
  font-weight: 500;
}

.score-date {
  font-size: 0.75rem;
  color: #64748b;
}

.dark .score-date {
  color: #94a3b8;
}

.score-value {
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--primary-color);
}

.no-scores {
  padding: 2rem;
  text-align: center;
  color: #94a3b8;
  font-size: 0.875rem;
}

.settings-options {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1rem;
  border-radius: var(--border-radius);
  background-color: var(--light-bg);
}

.dark .setting-item {
  background-color: var(--dark-bg);
}

.setting-info {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.setting-info h4 {
  font-size: 1rem;
  font-weight: 600;
}

.setting-info p {
  font-size: 0.875rem;
  color: #64748b;
}

.dark .setting-info p {
  color: #94a3b8;
}

.setting-control {
  display: flex;
  align-items: center;
}

.switch {
  position: relative;
  display: inline-block;
  width: 3rem;
  height: 1.5rem;
}

.switch input {
  opacity: 0;
  width: 0;
  height: 0;
}

.slider {
  position: absolute;
  cursor: pointer;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #cbd5e1;
  transition: var(--transition);
  border-radius: 1.5rem;
}

.slider:before {
  position: absolute;
  content: "";
  height: 1.25rem;
  width: 1.25rem;
  left: 0.125rem;
  bottom: 0.125rem;
  background-color: white;
  transition: var(--transition);
  border-radius: 50%;
}

input:checked + .slider {
  background-color: var(--primary-color);
}

input:checked + .slider:before {
  transform: translateX(1.5rem);
}

.data-actions {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.data-action-btn {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.75rem 1rem;
  border-radius: var(--border-radius);
  background-color: transparent;
  border: 1px solid #e2e8f0;
  color: var(--light-text);
  font-size: 0.875rem;
  font-weight: 500;
  cursor: pointer;
  transition: var(--transition);
}

.dark .data-action-btn {
  border-color: #334155;
}

.data-action-btn:hover {
  background-color: rgba(99, 102, 241, 0.05);
  border-color: var(--primary-color);
}

.dark .data-action-btn:hover {
  background-color: rgba(99, 102, 241, 0.1);
}

.data-action-btn.danger {
  color: var(--danger-color);
  border-color: rgba(239, 68, 68, 0.3);
}

.dark .data-action-btn.danger {
  border-color: rgba(239, 68, 68, 0.2);
}

.data-action-btn.danger:hover {
  background-color: rgba(239, 68, 68, 0.05);
  border-color: var(--danger-color);
}

.dark .data-action-btn.danger:hover {
  background-color: rgba(239, 68, 68, 0.1);
}

